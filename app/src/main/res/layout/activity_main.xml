<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AutoCare"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvVehicle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Vehicle: Royal Enfield"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvSpeed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Speed: 0 km/h"
        android:textSize="24sp" />

    <Button
        android:id="@+id/btnIncreaseSpeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Increase Speed" />

    <TextView
        android:id="@+id/tvTemperature"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Temperature: 28°C"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvBattery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Battery: 85%"
        android:textSize="20sp" />

</LinearLayout>